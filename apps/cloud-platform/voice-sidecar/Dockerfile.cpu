FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt

COPY server.py .
COPY repeat_filter.py .

ENV LOTARU_WHISPER_MODEL=small
ENV LOTARU_WHISPER_LANGUAGE=tr
ENV LOTARU_WHISPER_DEVICE=cpu
ENV LOTARU_WHISPER_COMPUTE=int8
ENV LOTARU_WHISPER_BEAM=2
ENV LOTARU_VOICE_SILENCE_SEC=2.0
ENV LOTARU_VOICE_MIN_SPEECH_SEC=0.7
ENV LOTARU_VOICE_PARTIAL_SEC=4.0
ENV LOTARU_VOICE_MAX_UTTERANCE_SEC=45

EXPOSE 18765

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=10 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18765/healthz', timeout=3)"

CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "18765"]
